# Sparr frontend environment. Copy to .env.local for local development.
# Never commit real values. On Vercel, set these in Project Settings → Environment Variables.

# Supabase project URL and the public "anon" key. Both are safe to expose to the browser:
# row-level security decides what each signed-in user may read or write.
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Base URL of the Python (FastAPI) backend. Not a secret.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-only (NO NEXT_PUBLIC_ prefix, never sent to the browser). Used by the waitlist
# server action. Leave unset to disable the waitlist form.
SUPABASE_SERVICE_ROLE_KEY=

# Provider switches. Everything runs on built-in rule-based engines; no external AI calls.
AI_PROVIDER=mock
BILLING_PROVIDER=mock
NOTIFICATIONS_EMAIL_PROVIDER=none
