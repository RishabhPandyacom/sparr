# Sparr API environment (copy to .env for local development; never commit .env)
SUPABASE_URL=https://<your-project-ref>.supabase.co
# Public "anon" key: used with the signed-in user's JWT, so Row Level Security applies.
SUPABASE_ANON_KEY=
# Service-role key: ONLY used to delete a user's account on request. Server-side only.
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated list of allowed browser origins (the deployed frontend + local dev).
CORS_ORIGINS=http://localhost:3000
